rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True for the state after the write, so a list and its first items can be created in one batch.
    function isMember(listId) {
      return signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/lists/$(listId)).data.memberUids;
    }

    // Join code -> list id. The code is the secret that lets someone find a list.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['listId', 'ownerName'])
        && getAfter(/databases/$(database)/documents/lists/$(request.resource.data.listId)).data.ownerUid == request.auth.uid;
      allow delete: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.memberUids;
    }

    match /lists/{listId} {
      // The list id is unguessable and only handed out through a code.
      allow get: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      // Someone with the code adds themselves (up to 4 people).
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && resource.data.memberUids.size() < 4
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members']);

      // A member updates the list: order notes, leaving, or (owner only) removing someone.
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.code == resource.data.code
        && request.resource.data.memberUids.size() <= resource.data.memberUids.size()
        && (request.resource.data.ownerUid == resource.data.ownerUid
            || (resource.data.ownerUid == request.auth.uid
                && !(request.auth.uid in request.resource.data.memberUids)
                && request.resource.data.ownerUid in request.resource.data.memberUids))
        && (request.resource.data.memberUids.size() == resource.data.memberUids.size()
            || request.auth.uid == resource.data.ownerUid
            || !(request.auth.uid in request.resource.data.memberUids));

      // The last person out deletes the list.
      allow delete: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.memberUids.size() == 1;

      match /items/{itemId} {
        allow read, write: if isMember(listId);
      }
    }
  }
}
